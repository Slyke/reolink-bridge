{
  mqtt: {
    url: "mqtt://mqtt.example.net:1883",
    baseTopic: "cameras",
    clientId: "reolink-bridge",
    snapshotMaxPayloadBytes: 1000000,
    // username: "camera-bridge",
    // password: "${CAMERA_BRIDGE_MQTT_PASSWORD}",
    // With an mqtts:// URL and a private CA or self-signed broker:
    // tls: { caFile: "./local-only/mqtt/broker-ca.pem" },
  },
  http: {
    listen: "0.0.0.0:8080",
    advertiseBaseUrl: "http://bridge.example.net:8080",
    token: "${CAMERA_BRIDGE_WS_TOKEN}",
    websocket: { path: "/ws" },
    // For HTTPS and WSS, use an https:// advertised URL and enable this:
    // tls: { serverNames: ["bridge.example.net"] },
  },
  cameras: [{
    id: "front-door",
    host: "camera.example.net",
    onvifPort: 8000,
    baichuanPort: 9000,
    username: "admin",
    password: "${CAMERA_PASSWORD}",
    channel: 0,
    eventTransport: "auto",
    ptz: "auto",
    coordinates: { allowVideoStream: false },
    // nativeWebhook: { protocol: "ha_cfg", token: "${CAMERA_WEBHOOK_TOKEN}" },
  }],
  // Enable background previews or the HTTP video relay for selected cameras.
  // api: {
  //   cameraReadRetries: 2, // Additional attempts for transient camera reads (0–10).
  //   previews: { cameras: { "front-door": { intervalMs: 5000 } } },
  //   media: { "front-door": { port: 554, streams: ["sub"] } },
  // },
  logging: {
    sinks: {
      console: { enabled: true, format: "json", levels: ["info", "warn", "error"] },
      // file: { enabled: true, format: "json", path: "./local-only/bridge.log.jsonl" },
    },
  },
  callbacks: [
    // { id: "automation", url: "http://automation.example.net/camera-events", cameras: ["front-door"], events: ["person", "vehicle", "pet"] },
  ],
}
